{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"nextjs",
 "git":{"deploymentEnabled":{"codex/ai-studio-phase-1":false}},
 "installCommand":"cd ../.. && npm ci",
 "buildCommand":"cd ../.. && npm run build",
 "outputDirectory":".next",
 "functions":{"app/api/**/route.ts":{"maxDuration":60}},
 "headers":[{"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
