# Copy to apps/web/.env.local. Only the public anon key belongs in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon keys are also supported when the publishable key is blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SIMULATION_API_URL=http://127.0.0.1:8000
# Render API environment (set on Render, not in apps/web/.env.local):
# TERRALAB_ENV=production
# TERRALAB_JOB_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-key
# TERRALAB_CORS_ORIGINS=https://your-frontend.vercel.app
# Render WORKER only (server secret, never NEXT_PUBLIC_ or Vercel/browser configuration):
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt
