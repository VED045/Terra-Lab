# Copy to apps/web/.env.local. Only the public anon key belongs in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon keys are also supported when the publishable key is blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SIMULATION_API_URL=http://127.0.0.1:8000
# Render API environment (set on Render, not in apps/web/.env.local):
# TERRALAB_ENV=production
# TERRALAB_JOB_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-key
# TERRALAB_CORS_ORIGINS=https://your-frontend.vercel.app
# Combined Render free Web Service: API + worker, no local worker required.
# TERRALAB_RUN_WORKER=1
# SUPABASE_SECRET_KEY=your-new-server-only-secret-key
# Never put the secret in NEXT_PUBLIC_ variables or Vercel frontend configuration.
# The combined supervisor creates its private worker wake channel automatically.
# No idle database polling or extra wake environment variables are required on Render.
# Legacy SUPABASE_SERVICE_ROLE_KEY remains compatible; replace any exposed credential.

# AI Studio (Next.js server only; never prefix these with NEXT_PUBLIC_).
# Required for signed-in users to save their own encrypted provider key.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TERRALAB_AI_COOKIE_KEY=
# Explicit local development only. Ignored in production; never a shared paid fallback.
TERRALAB_AI_LOCAL_DEV=0
TERRALAB_AI_DEV_DEEPSEEK_KEY=
# Optional: run Ollama beside the local Next.js dev server. No automatic model downloads.
TERRALAB_AI_OLLAMA_ENABLED=0
TERRALAB_AI_OLLAMA_URL=http://127.0.0.1:11434
# Optional fixed-command runner: trusted local development only, always disabled in production.
TERRALAB_AI_TESTING_ENABLED=0
# Set to 1 to reject hosted inference/credential saving. The laptop launcher enables this.
TERRALAB_AI_FREE_LOCAL_ONLY=0
# Optional explicit installed-model preference; never triggers a download.
TERRALAB_AI_OLLAMA_MODEL=
TERRALAB_AI_OLLAMA_ANALYSIS_MODEL=
TERRALAB_AI_OLLAMA_AGENT_MODEL=
